{
  "name": "firewatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Exploited vulnerability watch: CISA KEV, FIRST EPSS, MITRE ATT&CK and published detection rules",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "ingest": "node ingest/cli.ts",
    "ingest:news": "node ingest/cli.ts --news-only",
    "start": "node server/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
