# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=fission_ops
POSTGRES_USER=fission
POSTGRES_PASSWORD=fission_secret

# ─── Backend ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fission:fission_secret@postgres:5432/fission_ops
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_chars
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ─── Production HTTPS (docker-compose.prod.yml) ───────────────────────────────
# DOMAIN=fission.yourdomain.com
# SSL_EMAIL=admin@yourdomain.com

# ─── Rate Limiting (optional overrides) ──────────────────────────────────────
# RATE_LIMIT_GLOBAL_MAX=100
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_WINDOW_MS=900000

# ─── Email / SMTP (optional) ──────────────────────────────────────────────────
# Required for: password reset emails, IOC-confirmed notifications.
# Silently disabled if unset — app runs fine without it, but those emails won't send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Watchtower notifications (optional) ─────────────────────────────────────
# Reuses the SMTP settings above is NOT automatic — Watchtower needs its own vars.
WATCHTOWER_NOTIFICATIONS=
WATCHTOWER_EMAIL_FROM=
WATCHTOWER_EMAIL_TO=
WATCHTOWER_EMAIL_SERVER=
WATCHTOWER_EMAIL_SERVER_PORT=587
WATCHTOWER_EMAIL_USER=
WATCHTOWER_EMAIL_PASSWORD=

# ─── SSO (optional) ──────────────────────────────────────────────────────────
OIDC_AZURE_CLIENT_ID=
OIDC_AZURE_CLIENT_SECRET=
OIDC_AZURE_TENANT_ID=
OIDC_OKTA_CLIENT_ID=
OIDC_OKTA_CLIENT_SECRET=
OIDC_OKTA_DOMAIN=
SSO_REDIRECT_BASE_URL=http://localhost:3001

# ─── License Server ──────────────────────────────────────────────────────────
LICENSE_ADMIN_API_KEY=change_this_admin_api_key_min_16_chars
LICENSE_DB_PASSWORD=license_secret
LICENSE_SERVER_URL=http://license-server:3002

# ─── Main App License ────────────────────────────────────────────────────────
LICENSE_KEY=
